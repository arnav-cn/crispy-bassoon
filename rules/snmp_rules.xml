
<group name="snmp_trap">

    <!-- ===================================================== -->
    <!-- Base SNMP Trap Rule                                   -->
    <!-- ===================================================== -->

    <rule id="110000" level="0">
        <decoded_as>json</decoded_as>
        <field name="engine_id" type="pcre2">.+</field>
        <description>SNMP Trap Received</description>
    </rule>

    <!-- ===================================================== -->
    <!-- Standard SNMP Traps                                  -->
    <!-- ===================================================== -->

    <!-- Authentication Failure -->
    <rule id="110001" level="10">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.5</match>
        <description>SNMP Authentication Failure</description>
        <group>snmp,authentication,attack,</group>

        <mitre>
            <id>T1110</id>
        </mitre>
    </rule>

    <!-- Cold Start -->
    <rule id="110002" level="5">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.1</match>
        <description>SNMP Cold Start</description>
        <group>snmp,startup,</group>
    </rule>

    <!-- Warm Start -->
    <rule id="110003" level="4">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.2</match>
        <description>SNMP Warm Start</description>
        <group>snmp,startup,</group>
    </rule>

    <!-- Link Down -->
    <rule id="110004" level="8">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.3</match>
        <description>Network Interface Link Down</description>
        <group>snmp,interface,availability,</group>
    </rule>

    <!-- Link Up -->
    <rule id="110005" level="3">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.4</match>
        <description>Network Interface Link Up</description>
        <group>snmp,interface,</group>
    </rule>

    <!-- EGP Neighbor Loss -->
    <rule id="110006" level="7">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.6.3.1.1.5.6</match>
        <description>EGP Neighbor Loss</description>
        <group>snmp,routing,</group>
    </rule>

    <!-- ===================================================== -->
    <!-- Bridge / STP                                          -->
    <!-- ===================================================== -->

    <rule id="110010" level="6">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.2.1.17.0.2</match>
        <description>STP Topology Change Detected</description>
        <group>snmp,stp,network,</group>
    </rule>

    <!-- ===================================================== -->
    <!-- ENTITY-MIB                                            -->
    <!-- ===================================================== -->

    <rule id="110020" level="5">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.2.1.47.2.0.1</match>
        <description>Entity Configuration Changed</description>
        <group>snmp,configuration,</group>
    </rule>

    <!-- ===================================================== -->
    <!-- EdgeCore Vendor Traps                                 -->
    <!-- ===================================================== -->

    <!-- Login Event -->
    <rule id="110200" level="7">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.4.1.4413.1.1.1.0.29</match>

        <description>
EdgeCore User Login / Logout Event
        </description>

        <group>
snmp,edgecore,authentication,
        </group>

        <mitre>
            <id>T1078</id>
        </mitre>

    </rule>

    <!-- Login Failed -->
    <rule id="110201" level="10">
        <if_sid>110000</if_sid>
        <match>.1.3.6.1.4.1.4413.1.1.1.0.13</match>

        <description>
EdgeCore Login Failed
        </description>

        <group>
snmp,edgecore,authentication,
        </group>

        <mitre>
            <id>T1110</id>
        </mitre>

    </rule>

</group>