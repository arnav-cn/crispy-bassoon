  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"top_processes":\s*(.*)</regex>
  <order>top_processes</order>
</decoder>
-->
<decoder name="top_processes">
  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"top_processes":\s*{.*?"name":\s*".*?","memory":\s*".*?"}.*</regex>
  <order>top_processes</order>
</decoder>

<decoder name="process_entry">
  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"name":\s*"([^"]+)"\s*,\s*"memory":\s*"([^"]+)"</regex>
  <order>process_name,process_memory</order>
</decoder>

<decoder name="parsed_processes">
  <!-- Match the log format using regular expressions -->
  <prematch>process</prematch>
  <regex>\s*(\d+)\s*(\S+)\s*(\d+\.\d)\s*(\d+\.\d)\s*(\S+)\s*(\S+)$</regex>
  <order>PID, USER, %CPU, %MEM, TIME+, COMMAND</order>
</decoder>