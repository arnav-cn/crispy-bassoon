<decoder name="resource_monitor">
    <prematch>^{</prematch>
    <regex>"timestamp":\s*"([^"]+)"</regex>
    <order>timestamp</order>
</decoder>

<decoder name="cpu_usage">
  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"cpu_usage":\s*"(\d+\.\d+)%"</regex>
  <order>cpu_usage</order>
</decoder>

<decoder name="ram_usage">
  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"ram_usage":\s*"(\d+\.\d+)%"</regex>
  <order>ram_usage</order>
</decoder>

<decoder name="disk_usage">
  <parent>resource_monitor</parent>
  <prematch>^</prematch>
  <regex>"disk_usage":\s*"(\d+\.\d+)%"</regex>
  <order>disk_usage</order>
</decoder>

<!--
