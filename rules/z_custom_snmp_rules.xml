<!--
  Custom SNMP Trap Rules (snmp_rules)
  Uses <decoded_as>json</decoded_as> and <field name="oid">
-->

<group name="snmp_trap">

  <!-- loginSuccess (EdgeCore Login/Logout Event) OID: 1.3.6.1.4.1.4413.1.1.1.0.29 -->
  <rule id="110200" level="3" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.4.1.4413.1.1.1.0.29</match>
    <description>$(location) - $(engine_id), Session $(session_id) event for user $(session_user) connected from $(session_ip).</description>
    <group>authentication_success,pci_dss_10.2.5</group>
  </rule>

  <!-- Session started, type 4 -->
  <rule id="100316" level="3">
    <if_sid>110200</if_sid>
    <field name="action_code">^4$|^1$</field>
    <field name="session_id">^22$</field>
    <description>$(location) - $(engine_id), Session $(session_id) of type 4 started for user $(session_user) connected from $(session_ip).</description>
  </rule>

  <!-- Session started, type 2 -->
  <rule id="100317" level="3">
    <if_sid>110200</if_sid>
    <field name="action_code">^4$|^1$</field>
    <field name="session_id" type="pcre2">^(?!22$).*</field>
    <description>$(location) - $(engine_id), Session $(session_id) of type 2 started for user $(session_user) connected from $(session_ip).</description>
  </rule>

  <!-- Session ended, type 4 -->
  <rule id="100318" level="3">
    <if_sid>110200</if_sid>
    <field name="action_code" type="pcre2">^(?!4$|1$).*</field>
    <field name="session_id">^22$</field>
    <description>$(location) - $(engine_id), Session $(session_id) of type 4 ended for user $(session_user) connected from $(session_ip).</description>
  </rule>

  <!-- Session ended, type 2 -->
  <rule id="100319" level="3">
    <if_sid>110200</if_sid>
    <field name="action_code" type="pcre2">^(?!4$|1$).*</field>
    <field name="session_id" type="pcre2">^(?!22$).*</field>
    <description>$(location) - $(engine_id), Session $(session_id) of type 2 ended for user $(session_user) connected from $(session_ip).</description>
  </rule>

  <!-- topologyChange (STP Topology Change) OID: 1.3.6.1.2.1.17.0.2 -->
  <rule id="110010" level="5" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.2.1.17.0.2</match>
    <description>Spanning Tree Topology Change Received: MSTID: 0 0/10</description>
    <group>system_event</group>
  </rule>

  <!-- authenticationFailure OID: 1.3.6.1.6.3.1.1.5.5 -->
  <rule id="110001" level="5" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.6.3.1.1.5.5</match>
    <description>Authentication failure on device</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5</group>
  </rule>

  <!-- failedUserLogin (EdgeCore Failed Login) OID: 1.3.6.1.4.1.4413.1.1.1.0.13 -->
  <rule id="110201" level="7" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.4.1.4413.1.1.1.0.13</match>
    <description>Failed login attempt on device</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5</group>
  </rule>

  <!-- entConfigChange (Entity Configuration Change) OID: 1.3.6.1.2.1.47.2.0.1 -->
  <rule id="110020" level="5" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.2.1.47.2.0.1</match>
    <description>Entity Database: Configuration Changed</description>
    <group>config_changed,pci_dss_10.2.7</group>
  </rule>

  <!-- coldStart OID: 1.3.6.1.6.3.1.1.5.1 -->
  <rule id="110002" level="5" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.6.3.1.1.5.1</match>
    <description>Cold Start: Unit: 0</description>
    <group>system_reboot</group>
  </rule>

  <!-- warmStart OID: 1.3.6.1.6.3.1.1.5.2 -->
  <rule id="110003" level="3" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.6.3.1.1.5.2</match>
    <description>Device performed a warm start</description>
    <group>system_reboot</group>
  </rule>

  <!-- linkDown OID: 1.3.6.1.6.3.1.1.5.3 -->
  <rule id="110004" level="8" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.6.3.1.1.5.3</match>
    <description>Interface/Port has gone DOWN</description>
    <group>interface_down</group>
  </rule>

  <!-- linkUp OID: 1.3.6.1.6.3.1.1.5.4 -->
  <rule id="110005" level="3" overwrite="yes">
    <decoded_as>json</decoded_as>
    <match>.1.3.6.1.6.3.1.1.5.4</match>
    <description>Interface/Port has come UP</description>
    <group>interface_up</group>
  </rule>

  <!-- sfpInserted OID: 1.3.6.1.4.1.4413.1.1.1.1.4.1 -->
  <rule id="100310" level="3">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.1.1.4.1</field>
    <description>SFP inserted in port</description>
    <group>hardware_event</group>
  </rule>

  <!-- sfpRemoved OID: 1.3.6.1.4.1.4413.1.1.1.1.4.2 -->
  <rule id="100311" level="3">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.1.1.4.2</field>
    <description>SFP module removed</description>
    <group>hardware_event</group>
  </rule>

  <!-- macBindingViolation OID: 1.3.6.1.4.1.4413.1.1.20.2.1 -->
  <rule id="100312" level="10">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.20.2.1</field>
    <description>MAC address binding violation detected</description>
    <group>security_violation,pci_dss_10.6.1</group>
  </rule>

  <!-- temperatureAlarm OID: 1.3.6.1.4.1.4413.1.1.43.1.7 -->
  <rule id="100313" level="10">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.43.1.7</field>
    <description>Temperature threshold exceeded</description>
    <group>hardware_alarm</group>
  </rule>

  <!-- fanFailure OID: 1.3.6.1.4.1.4413.1.1.43.1.5 -->
  <rule id="100314" level="10">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.43.1.5</field>
    <description>Fan failure detected</description>
    <group>hardware_alarm</group>
  </rule>

  <!-- psuFailure OID: 1.3.6.1.4.1.4413.1.1.43.1.6 -->
  <rule id="100315" level="10">
    <decoded_as>json</decoded_as>
    <field name="oid">1.3.6.1.4.1.4413.1.1.43.1.6</field>
    <description>Power supply failure detected</description>
    <group>hardware_alarm</group>
  </rule>

</group>
